
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "GoldGodMenu"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local gold = Color3.fromRGB(255, 220, 145)
local brown = Color3.fromRGB(95, 60, 15)

local function round(obj)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = obj
end

local function makeButton(parent, text, size, pos, color)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.BackgroundColor3 = color
    b.TextColor3 = brown
    b.Text = text
    b.TextSize = 15
    b.Font = Enum.Font.GothamBold
    b.Parent = parent
    round(b)
    return b
end

-- Nút MENU nổi
local menuBtn = makeButton(
    gui, "MENU: ON",
    UDim2.fromOffset(120, 44),
    UDim2.new(0, 20, 0.4, 0), gold
)
menuBtn.Active = true
menuBtn.Draggable = true

-- Khung menu kéo được
local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(230, 145)
frame.Position = UDim2.new(0, 150, 0.4, 0)
frame.BackgroundColor3 = Color3.fromRGB(255, 238, 200)
frame.Active = true
frame.Draggable = true
frame.Parent = gui
round(frame)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 42)
title.BackgroundTransparency = 1
title.Text = "⚡ GODMODE"
title.TextColor3 = brown
title.TextSize = 21
title.Font = Enum.Font.GothamBold
title.Parent = frame

local godBtn = makeButton(
    frame, "GODMODE: OFF",
    UDim2.new(1, -20, 0, 42),
    UDim2.new(0, 10, 0, 48), gold
)

local hideBtn = makeButton(
    frame, "HIDE MENU",
    UDim2.new(1, -20, 0, 28),
    UDim2.new(0, 10, 0, 102),
    Color3.fromRGB(255, 230, 180)
)

-- MENU ON/OFF
menuBtn.Activated:Connect(function()
    frame.Visible = not frame.Visible
    menuBtn.Text = frame.Visible and "MENU: ON" or "MENU: OFF"
end)

hideBtn.Activated:Connect(function()
    frame.Visible = false
    menuBtn.Text = "MENU: OFF"
end)

-- GODMODE thử nghiệm Humanoid
local enabled = false
local healthConnection

local function setGodMode(state)
    enabled = state

    if healthConnection then
        healthConnection:Disconnect()
        healthConnection = nil
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if enabled and hum then
        healthConnection = hum.HealthChanged:Connect(function(health)
            if enabled and health > 0 and health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
        end)

        godBtn.Text = "GODMODE: ON"
        godBtn.BackgroundColor3 = Color3.fromRGB(100, 230, 130)
    else
        godBtn.Text = "GODMODE: OFF"
        godBtn.BackgroundColor3 = gold
    end
end

godBtn.Activated:Connect(function()
    setGodMode(not enabled)
end)

player.CharacterAdded:Connect(function()
    task.wait(1)
    if enabled then
        setGodMode(true)
    end
end)
